# Origen de la API.
#
# Tiene que ser el origen exacto —sin barra final y sin /api— porque el
# cliente le antepone /api/v1 y porque la cookie de sesión de Sanctum se
# negocia contra él.
#
# Local:      http://localhost:8000
# Producción: https://api.cafetit.com
NUXT_PUBLIC_API_BASE=http://localhost:8000
